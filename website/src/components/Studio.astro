---
import ShotSwitch from './ShotSwitch.astro';
import studioLight from '../assets/studio-light.webp';
import studioDark from '../assets/studio-dark.webp';
import studioEnLight from '../assets/studio-en-light.webp';
import studioEnDark from '../assets/studio-en-dark.webp';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].studio;

const icons = [
  '<circle cx="11" cy="11" r="6"/><path d="m20 20-4.5-4.5M11 8v6M8 11h6"/>',
  '<circle cx="12" cy="12" r="8"/><ellipse cx="12" cy="12" rx="3.5" ry="8"/><path d="M4 12h16"/>',
  '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 13h4M13 13h4M7 16h7"/>',
  '<circle cx="6" cy="7" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="M8 8.5 20 16M8 15.5 20 8"/>',
  '<rect x="3" y="6" width="18" height="12" rx="3"/><circle cx="16" cy="13" r="3"/>',
  '<path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19h14"/>',
];
---

<section class="studio" id="studio">
  <div class="wrap">
    <div class="studio-head">
      <div class="reveal">
        <div class="kicker">{t.kicker}</div>
        <h2 set:html={t.titleHtml} />
        <p class="sec-lede">{t.lede}</p>
      </div>
      <div class="formats reveal" role="img" aria-label={`${t.formats}: 16:9, 9:16, 1:1`}>
        <div style="width:64px;height:36px">16:9</div>
        <div style="width:28px;height:50px">9:16</div>
        <div style="width:42px;height:42px">1:1</div>
      </div>
    </div>

    <ShotSwitch
      class="studio-shot vf reveal"
      locale={lang}
      mode="dark"
      lang={lang}
      sizes="(min-width: 1228px) 1180px, calc(100vw - 48px)"
      shots={[
        { src: studioLight, alt: t.alt.zhLight, mode: 'light', lang: 'zh' },
        { src: studioDark, alt: t.alt.zhDark, mode: 'dark', lang: 'zh' },
        { src: studioEnLight, alt: t.alt.enLight, mode: 'light', lang: 'en' },
        { src: studioEnDark, alt: t.alt.enDark, mode: 'dark', lang: 'en' },
      ]}
    >
      <span class="vf-b"></span>
    </ShotSwitch>

    <div class="studio-grid reveal">
      {
        t.features.map((feature, i) => (
          <div>
            <div class="ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" set:html={icons[i]} />
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
