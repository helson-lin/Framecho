---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const t = ui[Astro.props.lang].flow;
---

<section class="sec">
  <div class="wrap">
    <div class="kicker reveal">{t.kicker}</div>
    <h2 class="reveal" set:html={t.titleHtml} />
    <div class="flow reveal">
      {
        t.steps.map((step, i) => (
          <div class="flow-step">
            <div class="n">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p set:html={step.bodyHtml} />
          </div>
        ))
      }
    </div>
  </div>
</section>
