---
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const locales = Object.keys(ui) as Locale[];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />
    {
      Astro.site && (
        <>
          <link rel="canonical" href={getAbsoluteLocaleUrl(lang)} />
          {locales.map((l) => (
            <link rel="alternate" hreflang={ui[l].htmlLang} href={getAbsoluteLocaleUrl(l)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('zh')} />
        </>
      )
    }
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />

    <script>
      const nav = document.getElementById('nav');
      addEventListener('scroll', () => nav?.classList.toggle('scrolled', scrollY > 8), { passive: true });

      // Light / dark and language toggles on screenshots.
      document.querySelectorAll<HTMLElement>('.appearance').forEach((group) => {
        const shot = group.closest<HTMLElement>('.appearance-shot');
        if (!shot) return;
        const key = group.dataset.key as 'mode' | 'lang';
        const buttons = group.querySelectorAll<HTMLButtonElement>('button');
        group.addEventListener('click', (event) => {
          const button = (event.target as Element).closest('button');
          if (!button) return;
          shot.dataset[key] = button.dataset[key];
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset[key] === shot.dataset[key])));
        });
      });

      // Real mosaic: render the text, average it into blocks and paint each block its mean color.
      function pixelate() {
        const dpr = devicePixelRatio || 1;
        const block = 6;
        document.querySelectorAll<HTMLElement>('.redact-demo .v.pixel').forEach((box) => {
          const source = box.querySelector('span');
          const canvas = box.querySelector('canvas');
          const w = box.clientWidth;
          const h = box.clientHeight;
          if (!source || !canvas || !w || !h) return;
          const text = getComputedStyle(source);
          const area = getComputedStyle(box);
          const full = document.createElement('canvas');
          full.width = Math.round(w * dpr);
          full.height = Math.round(h * dpr);
          const f = full.getContext('2d', { willReadFrequently: true })!;
          f.scale(dpr, dpr);
          f.fillStyle = area.backgroundColor;
          f.fillRect(0, 0, w, h);
          f.fillStyle = text.color;
          f.font = `${text.fontWeight} ${text.fontSize} ${text.fontFamily}`;
          f.textBaseline = 'middle';
          f.fillText(source.textContent ?? '', parseFloat(area.paddingLeft), h / 2);
          const pixels = f.getImageData(0, 0, full.width, full.height).data;
          const step = Math.round(block * dpr);
          canvas.width = full.width;
          canvas.height = full.height;
          const c = canvas.getContext('2d')!;
          for (let y = 0; y < full.height; y += step) {
            for (let x = 0; x < full.width; x += step) {
              let r = 0, g = 0, b = 0, n = 0;
              for (let yy = y; yy < Math.min(y + step, full.height); yy++) {
                for (let xx = x; xx < Math.min(x + step, full.width); xx++) {
                  const i = (yy * full.width + xx) * 4;
                  r += pixels[i]; g += pixels[i + 1]; b += pixels[i + 2]; n++;
                }
              }
              c.fillStyle = `rgb(${(r / n) | 0},${(g / n) | 0},${(b / n) | 0})`;
              c.fillRect(x, y, step, step);
            }
          }
        });
      }
      document.fonts.ready.then(pixelate);
      addEventListener('resize', pixelate);

      // Fade sections in as they scroll into view.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll<HTMLElement>('.reveal').forEach((el, i) => {
        el.style.transitionDelay = (el.closest('.hero, .keys, .bento, .privacy') ? (i % 4) * 70 : 0) + 'ms';
        observer.observe(el);
      });
    </script>
  </body>
</html>
